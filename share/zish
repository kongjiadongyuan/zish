#!/usr/bin/env bash
# zish — manage this machine's zish install.
set -euo pipefail

ZISH_DIR="${ZISH_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/zish}"
STATE="${ZISH_DIR}/state"
CHECK_FILE="${ZISH_DIR}/update-check"
CHECK_TTL="${ZISH_CHECK_TTL:-86400}"
DEFAULT_REPO="kongjiadongyuan/zish"
DEFAULT_REF="main"

THEME_FILE="${ZISH_DIR}/theme"
THEMES_TXT="${ZISH_DIR}/themes.txt"
EMOJI_FILE="${ZISH_DIR}/emoji"

usage() {
  cat <<EOF
Usage: zish <command>

  version      Print installed version
  check        Check the remote version now
  update       Fetch latest zish from the network and reinstall
  theme        Interactive picker (TTY), or: zish theme <name>
  emoji        Machine badge in the prompt, or: zish emoji 💻
  uninstall    Remove zish (keeps history and .zshrc outside the loader)
  help         This help
EOF
}

state_get() {
  local key="$1"
  [[ -r "$STATE" ]] || return 0
  sed -n "s/^${key}=//p" "$STATE" | head -1
}

check_get() {
  local key="$1"
  [[ -r "$CHECK_FILE" ]] || return 0
  sed -n "s/^${key}=//p" "$CHECK_FILE" | head -1
}

version_gt() {
  local a="$1" b="$2"
  [[ -n "$a" && -n "$b" && "$a" != "$b" ]] || return 1
  [[ "$(printf '%s\n%s\n' "$a" "$b" | sort -V | tail -n1)" == "$a" ]]
}

installer_url() {
  local repo ref
  repo="$(state_get repo)"
  ref="$(state_get ref)"
  repo="${repo:-$DEFAULT_REPO}"
  ref="${ref:-$DEFAULT_REF}"
  printf 'https://raw.githubusercontent.com/%s/%s/install-fishlike-zsh.sh\n' "$repo" "$ref"
}

download_to() {
  local url="$1" dest="$2"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --proto '=https' --tlsv1.2 --connect-timeout 15 --retry 3 -o "$dest" "$url"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$dest" "$url"
  else
    printf 'zish: need curl or wget\n' >&2
    exit 1
  fi
}

fetch_installer() {
  local dest
  dest="$(mktemp "${TMPDIR:-/tmp}/zish-installer.XXXXXX")"
  download_to "$(installer_url)" "$dest"
  chmod 0700 "$dest"
  printf '%s\n' "$dest"
}

fetch_remote_version() {
  local url v
  url="$(installer_url)"
  if command -v curl >/dev/null 2>&1; then
    v="$(curl -fsSL --proto '=https' --tlsv1.2 --connect-timeout 10 --retry 2 --max-time 20 "$url" \
      | sed -n 's/^INSTALLER_VERSION="\([^"]*\)".*/\1/p' | head -1)"
  elif command -v wget >/dev/null 2>&1; then
    v="$(wget -qO- -T 20 "$url" \
      | sed -n 's/^INSTALLER_VERSION="\([^"]*\)".*/\1/p' | head -1)"
  else
    return 1
  fi
  [[ -n "$v" ]] || return 1
  printf '%s\n' "$v"
}

write_check() {
  mkdir -p "$ZISH_DIR"
  cat >"$CHECK_FILE" <<EOF
checked_at=$1
remote=$2
EOF
  chmod 0600 "$CHECK_FILE"
}

print_notice() {
  local local_v="$1" remote="$2"
  if [[ -t 2 ]]; then
    printf '\033[1;33mzish update available:\033[0m %s → %s   run \033[1mzish update\033[0m\n' \
      "$local_v" "$remote" >&2
  else
    printf 'zish update available: %s → %s   run zish update\n' "$local_v" "$remote" >&2
  fi
}

cmd_version() {
  local v remote
  v="$(state_get version)"
  if [[ -z "$v" ]]; then
    printf 'zish: not installed\n' >&2
    exit 1
  fi
  printf 'zish %s\n' "$v"
  remote="$(check_get remote)"
  if version_gt "$remote" "$v"; then
    printf 'update available: %s  (zish update)\n' "$remote"
  fi
}

cmd_check() {
  local quiet=0 arg local_v remote
  for arg in "$@"; do
    case "$arg" in
      --quiet|-q) quiet=1 ;;
    esac
  done
  local_v="$(state_get version)"
  remote="$(fetch_remote_version)" || {
    (( quiet )) && exit 0
    printf 'zish: could not read remote version\n' >&2
    exit 1
  }
  write_check "$(date +%s)" "$remote"
  (( quiet )) && exit 0
  if [[ -z "$local_v" ]]; then
    printf 'remote %s\n' "$remote"
    exit 0
  fi
  if version_gt "$remote" "$local_v"; then
    printf 'zish %s (local)\n' "$local_v"
    printf 'zish %s (remote)\n' "$remote"
    print_notice "$local_v" "$remote"
  else
    printf 'zish %s (up to date)\n' "$local_v"
  fi
}

cmd_notice() {
  local local_v remote checked now age
  local_v="$(state_get version)"
  [[ -n "$local_v" ]] || return 0
  remote="$(check_get remote)"
  checked="$(check_get checked_at)"
  if [[ -n "$remote" ]] && version_gt "$remote" "$local_v"; then
    print_notice "$local_v" "$remote"
  fi
  now="$(date +%s)"
  age=$((now - ${checked:-0}))
  if [[ -z "$checked" || "$age" -ge "$CHECK_TTL" || "$age" -lt 0 ]]; then
    "$0" check --quiet >/dev/null 2>&1 &
    disown $! 2>/dev/null || true
  fi
  return 0
}

theme_current() {
  local n
  if [[ -r "$THEME_FILE" ]]; then
    n="$(tr -d '[:space:]' <"$THEME_FILE")"
  fi
  printf '%s\n' "${n:-default}"
}

theme_hex_fg() {
  local h="${1#\#}"
  printf '\033[38;2;%d;%d;%dm' \
    "$((16#${h:0:2}))" "$((16#${h:2:2}))" "$((16#${h:4:2}))"
}

theme_fields() {
  local name="$1" line
  [[ -r "$THEMES_TXT" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    set -- $line
    [[ "$1" == "$name" ]] || continue
    (( $# >= 7 )) || return 1
    printf '%s\n' "$@"
    return 0
  done <"$THEMES_TXT"
  return 1
}

theme_preview() {
  local name="$1" reset=$'\033[0m' bold=$'\033[1m'
  local line user host pathc gitc err
  [[ -r "$THEMES_TXT" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    set -- $line
    [[ "$1" == "$name" ]] || continue
    user=$2 host=$3 pathc=$4 gitc=$5 err=$6
    printf '%s' "$bold$(theme_hex_fg "$user")user${reset}"
    printf '@%s' "$(theme_hex_fg "$host")host${reset}"
    printf ' %s' "$(theme_hex_fg "$pathc")~${reset}"
    printf ' %s' "$(theme_hex_fg "$gitc")(main)${reset}"
    printf ' %s' "$bold$(theme_hex_fg "$err")[1]${reset}"
    printf '> \n'
    return 0
  done <"$THEMES_TXT"
  return 1
}

theme_apply() {
  local name="$1"
  if ! theme_fields "$name" >/dev/null; then
    printf 'zish: unknown theme: %s\n' "$name" >&2
    printf 'run: zish theme list\n' >&2
    exit 1
  fi
  mkdir -p "$ZISH_DIR"
  printf '%s\n' "$name" >"$THEME_FILE"
  chmod 0600 "$THEME_FILE"
  printf 'zish theme: %s\n' "$name"
  printf '  '
  theme_preview "$name"
  printf 'open a new terminal, or: exec zsh -l\n'
}

theme_list() {
  local cur line mark
  cur="$(theme_current)"
  [[ -r "$THEMES_TXT" ]] || { printf 'zish: missing %s\n' "$THEMES_TXT" >&2; exit 1; }
  printf 'current: %s\n\n' "$cur"
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    set -- $line
    [[ -n "$1" ]] || continue
    if [[ "$1" == "$cur" ]]; then mark='*'; else mark=' '; fi
    printf '%s %-16s ' "$mark" "$1"
    theme_preview "$1"
  done <"$THEMES_TXT"
}

theme_names() {
  local line
  [[ -r "$THEMES_TXT" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    set -- $line
    [[ -n "$1" ]] && printf '%s\n' "$1"
  done <"$THEMES_TXT"
}

theme_fzf() {
  local bin="$ZISH_DIR/bin/fzf" cur picked self
  [[ -x "$bin" ]] || bin="$(command -v fzf 2>/dev/null || true)"
  [[ -n "$bin" && -x "$bin" ]] || return 1
  cur="$(theme_current)"
  self="$0"
  picked="$(
    theme_names | "$bin" \
      --ansi --reverse --height=40% \
      --prompt='theme> ' \
      --header="current: ${cur}   enter to apply, esc to cancel" \
      --preview="$self theme --preview {}" \
      --preview-window=down,3,wrap
  )" || return 1
  [[ -n "$picked" ]] || return 1
  theme_apply "$picked"
}

theme_menu() {
  local cur line i=0 n pick
  local -a names
  cur="$(theme_current)"
  [[ -r "$THEMES_TXT" ]] || { printf 'zish: missing %s\n' "$THEMES_TXT" >&2; exit 1; }
  printf 'current: %s\n\n' "$cur"
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    set -- $line
    [[ -n "$1" ]] || continue
    i=$((i + 1))
    names[$i]=$1
    if [[ "$1" == "$cur" ]]; then
      printf '%2d) * %-16s ' "$i" "$1"
    else
      printf '%2d)   %-16s ' "$i" "$1"
    fi
    theme_preview "$1"
  done <"$THEMES_TXT"
  printf '\nnumber (empty cancels): '
  IFS= read -r n || return 1
  [[ -n "$n" ]] || { printf 'cancelled\n'; return 1; }
  [[ "$n" == [1-9] || "$n" == [1-9][0-9] ]] || { printf 'zish: not a number\n' >&2; return 1; }
  pick="${names[$n]:-}"
  [[ -n "$pick" ]] || { printf 'zish: out of range\n' >&2; return 1; }
  theme_apply "$pick"
}

cmd_theme() {
  local name="${1:-}"
  case "$name" in
    --preview)
      theme_preview "${2:-}"
      return
      ;;
    list|-l|--list)
      theme_list
      return
      ;;
    '')
      if [[ -t 0 && -t 1 ]]; then
        if theme_fzf; then
          return
        fi
        # No fzf, or fzf not usable: numbered menu.
        local bin="$ZISH_DIR/bin/fzf"
        [[ -x "$bin" ]] || bin="$(command -v fzf 2>/dev/null || true)"
        if [[ -n "$bin" && -x "$bin" ]]; then
          return 1
        fi
        theme_menu
      else
        theme_list
      fi
      return
      ;;
    *)
      theme_apply "$name"
      ;;
  esac
}

emoji_current() {
  local s
  if [[ -r "$EMOJI_FILE" ]]; then
    s="$(tr -d '\n\r' <"$EMOJI_FILE")"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
  fi
  printf '%s\n' "$s"
}

emoji_catalog() {
  cat <<'EOF'
none	(no badge)
💻	laptop
🖥️	desktop
🍎	mac
🐧	linux
🏠	home
☁️	cloud
🗄️	server
🔧	toolbox
🚀	rocket
🐱	cat
🐸	frog
🐙	octopus
🦀	crab
🐝	bee
🦊	fox
🐺	wolf
🐻	bear
🔥	fire
❄️	ice
🌙	moon
⭐	star
💎	gem
⚡	zap
🌊	wave
🍀	clover
🎃	pumpkin
🧿	nazar
🧩	puzzle
🎯	target
EOF
}

emoji_apply() {
  local glyph="$1"
  mkdir -p "$ZISH_DIR"
  if [[ -z "$glyph" || "$glyph" == none || "$glyph" == off || "$glyph" == clear ]]; then
    rm -f -- "$EMOJI_FILE"
    printf 'zish emoji: (none)\n'
  else
    printf '%s\n' "$glyph" >"$EMOJI_FILE"
    chmod 0600 "$EMOJI_FILE"
    printf 'zish emoji: %s\n' "$glyph"
  fi
  printf 'open a new terminal, or: exec zsh -l\n'
}

emoji_from_catalog() {
  local want="$1" glyph label
  while IFS=$'\t' read -r glyph label || [[ -n "$glyph" ]]; do
    [[ "$glyph" == "$want" || "$label" == "$want" ]] && { printf '%s\n' "$glyph"; return 0; }
  done < <(emoji_catalog)
  return 1
}

emoji_fzf() {
  local bin="$ZISH_DIR/bin/fzf" picked glyph cur
  [[ -x "$bin" ]] || bin="$(command -v fzf 2>/dev/null || true)"
  [[ -n "$bin" && -x "$bin" ]] || return 1
  cur="$(emoji_current)"
  picked="$(
    emoji_catalog | "$bin" \
      --ansi --reverse --height=40% \
      --prompt='emoji> ' \
      --header="current: ${cur:-none}   enter to apply, esc to cancel   or: zish emoji 💻" \
      --delimiter=$'\t' --with-nth=1,2
  )" || return 1
  [[ -n "$picked" ]] || return 1
  glyph="${picked%%$'\t'*}"
  emoji_apply "$glyph"
}

emoji_menu() {
  local line i=0 n pick glyph
  local -a glyphs
  printf 'current: %s\n\n' "$(emoji_current)"
  while IFS=$'\t' read -r glyph _ || [[ -n "$glyph" ]]; do
    i=$((i + 1))
    glyphs[$i]=$glyph
    printf '%2d) %s\n' "$i" "$glyph"
  done < <(emoji_catalog)
  printf '\nnumber (empty cancels): '
  IFS= read -r n || return 1
  [[ -n "$n" ]] || { printf 'cancelled\n'; return 1; }
  [[ "$n" == [1-9] || "$n" == [1-9][0-9] ]] || { printf 'zish: not a number\n' >&2; return 1; }
  pick="${glyphs[$n]:-}"
  [[ -n "$pick" ]] || { printf 'zish: out of range\n' >&2; return 1; }
  emoji_apply "$pick"
}

cmd_emoji() {
  local arg="${1:-}" mapped
  case "$arg" in
    '')
      if [[ -t 0 && -t 1 ]]; then
        if emoji_fzf; then
          return
        fi
        local bin="$ZISH_DIR/bin/fzf"
        [[ -x "$bin" ]] || bin="$(command -v fzf 2>/dev/null || true)"
        if [[ -n "$bin" && -x "$bin" ]]; then
          return 1
        fi
        emoji_menu
      else
        printf 'current: %s\n' "$(emoji_current)"
        emoji_catalog
      fi
      ;;
    *)
      if mapped="$(emoji_from_catalog "$arg")"; then
        emoji_apply "$mapped"
      else
        emoji_apply "$arg"
      fi
      ;;
  esac
}

cmd_update() {
  local inst cleanup
  inst="$(fetch_installer)"
  # Bake the path into the trap. `local inst` is gone when EXIT runs after return,
  # and with `set -u` that becomes: inst: unbound variable.
  printf -v cleanup 'rm -f -- %q' "$inst"
  trap "$cleanup" EXIT
  bash "$inst" --force --non-interactive --no-chsh
  rm -f -- "$CHECK_FILE"
  trap - EXIT
  eval "$cleanup"
}

cmd_uninstall() {
  local inst cleanup
  inst="$ZISH_DIR/install.sh"
  if [[ -x "$inst" || -f "$inst" ]]; then
    bash "$inst" --uninstall "$@"
    return
  fi
  inst="$(fetch_installer)"
  printf -v cleanup 'rm -f -- %q' "$inst"
  trap "$cleanup" EXIT
  bash "$inst" --uninstall "$@"
  trap - EXIT
  eval "$cleanup"
}

cmd="${1:-help}"
shift || true
case "$cmd" in
  version|-v|--version) cmd_version ;;
  check) cmd_check "$@" ;;
  notice) cmd_notice ;;
  theme) cmd_theme "$@" ;;
  emoji) cmd_emoji "$@" ;;
  update|upgrade) cmd_update ;;
  uninstall) cmd_uninstall "$@" ;;
  help|-h|--help) usage ;;
  *)
    printf 'zish: unknown command: %s\n' "$cmd" >&2
    usage >&2
    exit 1
    ;;
esac
