#!/usr/bin/env bash
# zish — manage this machine's zish install.
set -euo pipefail

ZISH_DIR="${ZISH_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/zish}"
STATE="${ZISH_DIR}/state"
CHECK_FILE="${ZISH_DIR}/update-check"
CHECK_TTL="${ZISH_CHECK_TTL:-86400}"
DEFAULT_REPO="kongjiadongyuan/zish"
DEFAULT_REF="main"

THEME_FILE="${ZISH_DIR}/theme"
THEMES_TXT="${ZISH_DIR}/themes.txt"

usage() {
  cat <<EOF
Usage: zish <command>

  version      Print installed version
  check        Check the remote version now
  update       Fetch latest zish from the network and reinstall
  theme        List prompt themes, or: zish theme <name>
  uninstall    Remove zish (keeps history and .zshrc outside the loader)
  help         This help
EOF
}

state_get() {
  local key="$1"
  [[ -r "$STATE" ]] || return 0
  sed -n "s/^${key}=//p" "$STATE" | head -1
}

check_get() {
  local key="$1"
  [[ -r "$CHECK_FILE" ]] || return 0
  sed -n "s/^${key}=//p" "$CHECK_FILE" | head -1
}

version_gt() {
  local a="$1" b="$2"
  [[ -n "$a" && -n "$b" && "$a" != "$b" ]] || return 1
  [[ "$(printf '%s\n%s\n' "$a" "$b" | sort -V | tail -n1)" == "$a" ]]
}

installer_url() {
  local repo ref
  repo="$(state_get repo)"
  ref="$(state_get ref)"
  repo="${repo:-$DEFAULT_REPO}"
  ref="${ref:-$DEFAULT_REF}"
  printf 'https://raw.githubusercontent.com/%s/%s/install-fishlike-zsh.sh\n' "$repo" "$ref"
}

download_to() {
  local url="$1" dest="$2"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --proto '=https' --tlsv1.2 --connect-timeout 15 --retry 3 -o "$dest" "$url"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$dest" "$url"
  else
    printf 'zish: need curl or wget\n' >&2
    exit 1
  fi
}

fetch_installer() {
  local dest
  dest="$(mktemp "${TMPDIR:-/tmp}/zish-installer.XXXXXX")"
  download_to "$(installer_url)" "$dest"
  chmod 0700 "$dest"
  printf '%s\n' "$dest"
}

fetch_remote_version() {
  local url v
  url="$(installer_url)"
  if command -v curl >/dev/null 2>&1; then
    v="$(curl -fsSL --proto '=https' --tlsv1.2 --connect-timeout 10 --retry 2 --max-time 20 "$url" \
      | sed -n 's/^INSTALLER_VERSION="\([^"]*\)".*/\1/p' | head -1)"
  elif command -v wget >/dev/null 2>&1; then
    v="$(wget -qO- -T 20 "$url" \
      | sed -n 's/^INSTALLER_VERSION="\([^"]*\)".*/\1/p' | head -1)"
  else
    return 1
  fi
  [[ -n "$v" ]] || return 1
  printf '%s\n' "$v"
}

write_check() {
  mkdir -p "$ZISH_DIR"
  cat >"$CHECK_FILE" <<EOF
checked_at=$1
remote=$2
EOF
  chmod 0600 "$CHECK_FILE"
}

print_notice() {
  local local_v="$1" remote="$2"
  if [[ -t 2 ]]; then
    printf '\033[1;33mzish update available:\033[0m %s → %s   run \033[1mzish update\033[0m\n' \
      "$local_v" "$remote" >&2
  else
    printf 'zish update available: %s → %s   run zish update\n' "$local_v" "$remote" >&2
  fi
}

cmd_version() {
  local v remote
  v="$(state_get version)"
  if [[ -z "$v" ]]; then
    printf 'zish: not installed\n' >&2
    exit 1
  fi
  printf 'zish %s\n' "$v"
  remote="$(check_get remote)"
  if version_gt "$remote" "$v"; then
    printf 'update available: %s  (zish update)\n' "$remote"
  fi
}

cmd_check() {
  local quiet=0 arg local_v remote
  for arg in "$@"; do
    case "$arg" in
      --quiet|-q) quiet=1 ;;
    esac
  done
  local_v="$(state_get version)"
  remote="$(fetch_remote_version)" || {
    (( quiet )) && exit 0
    printf 'zish: could not read remote version\n' >&2
    exit 1
  }
  write_check "$(date +%s)" "$remote"
  (( quiet )) && exit 0
  if [[ -z "$local_v" ]]; then
    printf 'remote %s\n' "$remote"
    exit 0
  fi
  if version_gt "$remote" "$local_v"; then
    printf 'zish %s (local)\n' "$local_v"
    printf 'zish %s (remote)\n' "$remote"
    print_notice "$local_v" "$remote"
  else
    printf 'zish %s (up to date)\n' "$local_v"
  fi
}

cmd_notice() {
  local local_v remote checked now age
  local_v="$(state_get version)"
  [[ -n "$local_v" ]] || return 0
  remote="$(check_get remote)"
  checked="$(check_get checked_at)"
  if [[ -n "$remote" ]] && version_gt "$remote" "$local_v"; then
    print_notice "$local_v" "$remote"
  fi
  now="$(date +%s)"
  age=$((now - ${checked:-0}))
  if [[ -z "$checked" || "$age" -ge "$CHECK_TTL" || "$age" -lt 0 ]]; then
    "$0" check --quiet >/dev/null 2>&1 &
    disown $! 2>/dev/null || true
  fi
  return 0
}

theme_current() {
  local n
  if [[ -r "$THEME_FILE" ]]; then
    n="$(tr -d '[:space:]' <"$THEME_FILE")"
  fi
  printf '%s\n' "${n:-default}"
}

theme_hex_fg() {
  local h="${1#\#}"
  printf '\033[38;2;%d;%d;%dm' \
    "$((16#${h:0:2}))" "$((16#${h:2:2}))" "$((16#${h:4:2}))"
}

theme_fields() {
  local name="$1" line
  [[ -r "$THEMES_TXT" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    set -- $line
    [[ "$1" == "$name" ]] || continue
    (( $# >= 7 )) || return 1
    printf '%s\n' "$@"
    return 0
  done <"$THEMES_TXT"
  return 1
}

theme_preview() {
  local name="$1" reset=$'\033[0m' bold=$'\033[1m'
  local line user host pathc gitc err
  [[ -r "$THEMES_TXT" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    set -- $line
    [[ "$1" == "$name" ]] || continue
    user=$2 host=$3 pathc=$4 gitc=$5 err=$6
    printf '%s' "$bold$(theme_hex_fg "$user")user${reset}"
    printf '@%s' "$(theme_hex_fg "$host")host${reset}"
    printf ' %s' "$(theme_hex_fg "$pathc")~${reset}"
    printf ' %s' "$(theme_hex_fg "$gitc")(main)${reset}"
    printf ' %s' "$bold$(theme_hex_fg "$err")[1]${reset}"
    printf '> \n'
    return 0
  done <"$THEMES_TXT"
  return 1
}

cmd_theme() {
  local name="${1:-}" cur f
  cur="$(theme_current)"
  if [[ -z "$name" || "$name" == list ]]; then
    [[ -r "$THEMES_TXT" ]] || { printf 'zish: missing %s\n' "$THEMES_TXT" >&2; exit 1; }
    printf 'current: %s\n\n' "$cur"
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ -z "$line" || "$line" == \#* ]] && continue
      set -- $line
      [[ -n "$1" ]] || continue
      if [[ "$1" == "$cur" ]]; then
        printf '* %-16s ' "$1"
      else
        printf '  %-16s ' "$1"
      fi
      theme_preview "$1"
    done <"$THEMES_TXT"
    return 0
  fi
  if ! theme_fields "$name" >/dev/null; then
    printf 'zish: unknown theme: %s\n' "$name" >&2
    printf 'run: zish theme\n' >&2
    exit 1
  fi
  mkdir -p "$ZISH_DIR"
  printf '%s\n' "$name" >"$THEME_FILE"
  chmod 0600 "$THEME_FILE"
  printf 'zish theme: %s\n' "$name"
  printf '  '
  theme_preview "$name"
  printf 'open a new terminal, or: exec zsh -l\n'
}

cmd_update() {
  local inst cleanup
  inst="$(fetch_installer)"
  # Bake the path into the trap. `local inst` is gone when EXIT runs after return,
  # and with `set -u` that becomes: inst: unbound variable.
  printf -v cleanup 'rm -f -- %q' "$inst"
  trap "$cleanup" EXIT
  bash "$inst" --force --non-interactive --no-chsh
  rm -f -- "$CHECK_FILE"
  trap - EXIT
  eval "$cleanup"
}

cmd_uninstall() {
  local inst cleanup
  inst="$ZISH_DIR/install.sh"
  if [[ -x "$inst" || -f "$inst" ]]; then
    bash "$inst" --uninstall "$@"
    return
  fi
  inst="$(fetch_installer)"
  printf -v cleanup 'rm -f -- %q' "$inst"
  trap "$cleanup" EXIT
  bash "$inst" --uninstall "$@"
  trap - EXIT
  eval "$cleanup"
}

cmd="${1:-help}"
shift || true
case "$cmd" in
  version|-v|--version) cmd_version ;;
  check) cmd_check "$@" ;;
  notice) cmd_notice ;;
  theme) cmd_theme "$@" ;;
  update|upgrade) cmd_update ;;
  uninstall) cmd_uninstall "$@" ;;
  help|-h|--help) usage ;;
  *)
    printf 'zish: unknown command: %s\n' "$cmd" >&2
    usage >&2
    exit 1
    ;;
esac
